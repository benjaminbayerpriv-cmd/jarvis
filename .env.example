ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_VOICE_ID=bIHbv24MWmeRgasZH58o

LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen2.5-7b-instruct

# Embedding model for semantic memory search over the Obsidian vault (see
# backend/vector_memory.py) — must be loaded in LM Studio like any other
# model. Without it, semantic search silently falls back to plain keyword
# matching (memory.py's original behaviour).
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# Optional: DeepSeek Cloud-LLM (OpenAI-kompatibel). Sobald DEEPSEEK_API_KEY
# gesetzt ist, läuft die Text-Generierung darüber.
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Optional: Gemini (Google AI Studio free tier). Nur für das experimentelle
# backend/live_voice_test.py, nicht Teil der normalen Jarvis-Pipeline.
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash

# Optional: Tavily Search API (kostenlos: 1000 Credits/Monat, keine
# Kreditkarte nötig, tavily.com). Ohne Key öffnet web_search nur die Suche
# im Browser statt echte Ergebnisse zurückzugeben.
TAVILY_API_KEY=your-tavily-key

JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
