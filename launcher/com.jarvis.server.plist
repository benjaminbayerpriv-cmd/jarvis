<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: __JARVIS_ROOT__ is substituted by
     launcher/install_macos_autostart.sh at install time — do not `cp` this
     file directly, it has no real path in it (see that script). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jarvis.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>__JARVIS_ROOT__/.venv/bin/python3</string>
    <string>-m</string>
    <string>backend.main</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__JARVIS_ROOT__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__JARVIS_ROOT__/launcher/server.log</string>
  <key>StandardErrorPath</key>
  <string>__JARVIS_ROOT__/launcher/server.err.log</string>
</dict>
</plist>
